onalProperties\":false,\"properties\":{\"criticality\":{\"enum\":[\"contextual\",\"high\",\"critical\"],\"type\":\"string\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"rationale\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"assessed\",\"review_required\"],\"type\":\"string\"}},\"required\":[\"criticality\",\"status\",\"evidenceRefs\",\"rationale\"],\"type\":\"object\"},\"change\":{\"additionalProperties\":false,\"properties\":{\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"summary\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"evidenceRefs\",\"summary\"],\"type\":\"object\"},\"edges\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"from\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"minLength\":1,\"type\":\"string\"},\"relation\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"active\",\"inactive\"],\"type\":\"string\"},\"to\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\",\"from\",\"to\",\"relation\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"type\":\"array\"},\"nodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assetRef\":{\"minLength\":1,\"type\":\"string\"},\"concept\":{\"enum\":[\"reconnaissance\",\"credential_activity\",\"compromise_evidence\",\"benign_operation\",\"source_correction\",\"attack_hypothesis\"],\"type\":\"string\"},\"counts\":{\"addit