Count\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"p2\"],\"from\":\"obs:p2\",\"id\":\"interpret:p2\",\"relation\":\"supports\",\"status\":\"active\",\"to\":\"hypothesis:primary\"},{\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"p4\"],\"from\":\"obs:p4\",\"id\":\"interpret:p4\",\"relation\":\"supports\",\"status\":\"active\",\"to\":\"hypothesis:primary\"},{\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"p7\"],\"from\":\"obs:p7\",\"id\":\"interpret:p7\",\"relation\":\"contradicts\",\"status\":\"active\",\"to\":\"hypothesis:primary\"},{\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"p9\"],\"from\":\"obs:p9\",\"id\":\"interpret:p9\",\"relation\":\"supports\",\"status\":\"active\",\"to\":\"hypothesis:primary\"},{\"counts\":{\"provenanceRootCount\":2,\"reportCount\":2,\"underlyingEventCount\":2},\"evidenceRefs\":[\"p2\",\"p4\"],\"from\":\"obs:p2\",\"id\":\"order:p2:p4\",\"relation\":\"precedes\",\"status\":\"active\",\"to\":\"obs:p4\"},{\"counts\":{\"provenanceRootCount\":2,\"reportCount\":2,\"underlyingEventCount\":2},\"evidenceRefs\":[\"p4\",\"p9\"],\"from\":\"obs:p4\",\"id\":\"order:p4:p9\",\"relation\":\"precedes\",\"status\":\"active\",\"to\":\"obs:p9\"}],\"nodes\":[{\"assetRef\":\"service-P\",\"concept\":\"reconnaissance\",\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"p2\"],\"id\":\"obs:p2\",\"kind\":\"observation\",\"status\":\"observed\"},{\"assetRef\":\"service-P\",\"concept\":\"credential_activity\",\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"p4\"],\"id\":\"obs:p4\",\"kind\":\"observation\",\"status\":\"observed\"},{\"assetRef\":\"service-P\",\"concept\":\"benign_operation\",\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\"