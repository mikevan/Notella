{"concepts":{"interpretation":"A finding justified by the observation and supplied rule.","observation":"A measured temperature with units and sensor identity.","threshold":"A supplied comparison rule, not a measured value."},"instruction":"Explain whether the supplied temperature exceeds the configured threshold. A threshold is a policy parameter, not a reading. Do not infer a fire, cause, or physical sensor identity beyond the supplied evidence.","name":"Workshop temperature interpretation","outputSchema":{"additionalProperties":false,"properties":{"exceedsThreshold":{"type":"boolean"},"finding":{"minLength":1,"type":"string"},"limitation":{"minLength":1,"type":"string"}},"required":["finding","exceedsThreshold","limitation"],"type":"object"},"relations":[{"object":"observation","predicate":"supportedBy","subject":"interpretation"},{"object":"threshold","predicate":"comparedAgainst","subject":"interpretation"}],"version":"1.0.0"}
