alProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"from\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"minLength\":1,\"type\":\"string\"},\"relation\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"active\",\"inactive\"],\"type\":\"string\"},\"to\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\",\"from\",\"to\",\"relation\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"type\":\"array\"},\"nodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assetRef\":{\"minLength\":1,\"type\":\"string\"},\"concept\":{\"enum\":[\"reconnaissance\",\"credential_activity\",\"compromise_evidence\",\"benign_operation\",\"source_correction\",\"attack_hypothesis\"],\"type\":\"string\"},\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"id\":{\"minLength\":1,\"type\":\"string\"},\"kind\":{\"enum\":[\"observation\",\"hypothesis\"],\"type\":\"string\"},\"status\":{\"enum\":[\"observed\",\"retracted\",\"proposed\",\"supported\",\"weakened\",\"withdrawn\"],\"type\":\"string\"}},\"required\":[\"id\",\"kind\",\"concept\",\"assetRef\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"}},\"required\":[\"asOfMs\",\"nodes\",\"edges\",\"assessment\",\"change\"],\"type\":\"object\"}","promptSha256":"d724d5ccd71797d6e41a9ab6cd660d4c4f03f539c3da98debff317b79bedaf5e","source":{"id":"N-660","kind":"synthetic","labelAuthor":"Codex author/reviewer against unchanged rule reference; not independent","permission":"Owner-authorized curriculum repair; synthetic assertions","reference":"scenario-model-v5/prepare.py","trainingAllowed":true},"split":"train"},{"concepts":["reconnaissance","credential_activity","compromise_evidence","benign_operation","source_correction","attack_hypothesis"],"datasetVersion":"notella-curriculum-v1","family":"retraction-authoring-suite-001","id":"N-660-step-2","messages":[{"content":"The ontology represents the semantic model. Reconstruct the evidence-backed semantic state from only the visible scenario prefix and interpret its morphology. Preserve observations, duplicates, corrections and previous graph identities. Use policy network-scenario-policy-v1-development: primary asset only; retractions invalidate all reports of the retracted underlying event. A current supplied reviewed compromise_evidence assertion warrants critical. Otherwise reconnaissance followed by credential_activity on the primary asset, with strictly supported order and an entire delay interval within 120000 ms, warrants high. Either alone is contextual. A benign_operation negates this scan/credential association only when its explains list covers both reports; it does not negate separate compromise evidence. Unresolved clocks or uncertain order for an otherwise relevant pair require review, not a guessed link. After a compromise retraction reassess the remaining evidence. Do not link unrelated assets, turn report counts into independent corroboration, or infer causation, actor identity or numerical attack probability. Full-prefix reconstruction is not evidence of persistent model memory.\nOntology: {\"concepts\":{\"attack_hypothesis\":\"A scoped interpretation of potentially related hostile activity, distinct from causal proof or perpetrator attribution.\",\"benign_operation\":\"A supplied reviewed explanation for explicitly referenced observations; not a universal clearance.\",\"compromise_evidence\":\"A supplied reviewed assertion of unauthorized privileged access; authenticity is established outside this model.\",\"credential_activity\":\"Observed authentication failures; not proof of successful access.\",\"reconnaissance\":\"An observed scan of an identified asset; not proof of compromise.\",\"source_correction\":\"An explicit retraction of earlier available evidence; retain the claim and its correction.\"},\"relations\":[{\"object\":\"attack_hypothesis\",\"predicate\":\"supports\",\"subject\":\"reconnaissance\"},{\"object\":\"attack_hypothesis\",\"predicate\":\"supports\",\"subject\":\"credential_activity\"},{\"object\":\"attack_hypothesis\",\"predicate\":\"supports\",\"subject\":\"compromise_evidence\"},{\"object\":\"attack_hypothesis\",\"predicate\":\"contradicts\",\"subject\":\"benign_operation\"},{\"object\":\"compromise_evidence\",\"predicate\":\"contradicts\",\"subject\":\"source_correction\"},{\"object\":\"credential_activity\",\"predicate\":\"precedes\",\"subject\":\"reconnaissance\"},{\"object\":\"compromise_evidence\",\"predicate\":\"precedes\",\"subject\":\"credential_activity\"}]}\nReturn JSON matching: {\"additionalProperties\":false,\"properties\":{\"asOfMs\":{\"minimum\":0,\"type\":\"integer\"},\"assessment\":{\"additionalProperties\":false,\"properties\":{\"criticality\":{\"enum\":[\"contextual\",\"high\",\"critical\"],\"type\":\"string\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"rationale\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"assessed\",\"review_required\"],\"type\":\"string\"}},\"required\":[\"criticality\",\"status\",\"evidenceRefs\",\"rationale\"],\"type\":\"object\"},\"change\":{\"additionalProperties\":false,\"properties\":{\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"summary\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"evidenceRefs\",\"summary\"],\"type\":\"object\"},\"edges\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"from\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"minLength\":1,\"type\":\"string\"},\"relation\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"active\",\"inactive\"],\"type\":\"string\"},\"to\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\",\"from\",\"to\",\"relation\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"type\":\"array\"},\"nodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assetRef\":{\"minLength\":1,\"type\":\"string\"},\"concept\":{\"enum\":[\"reconnaissance\",\"credential_activity\",\"compromise_evidence\",\"benign_operation\",\"source_correction\",\"attack_hypothesis\"],\"type\":\"string\"},\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"id\":{\"minLength\":1,\"type\":\"string\"},\"kind\":{\"enum\":[\"observation\",\"hypothesis\"],\"type\":\"string\"},\"status\":{\"enum\":[\"observed\",\"retracted\",\"proposed\",\"supported\",\"weakened\",\"withdrawn\"],\"type\":\"string\"}},\"required\":[\"id\",\"kind\",\"concept\",\"assetRef\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"}},\"required\":[\"asOfMs\",\"nodes\",\"edges\",\"assessment\",\"change\"],\"type\":\"object\"}","role":"system"},{"content":"{\"asOfMs\":164200,\"assets\":[\"host-C\"],\"evidence\":[{\"assetRef\":\"host-C\",\"availableAtMs\":150200,\"concept\":\"compromise_evidence\",\"id\":\"c1\",\"originEventId\":\"origin:c1\",\"sourceRoot\":\"source:c1\",\"statement\":\"Synthetic supplied compromise_evidence for host-C\",\"timeMs\":150000,\"uncertaintyMs\":80},{\"assetRef\":\"host-C\",\"availableAtMs\":157200,\"concept\":\"compromise_evidence\",\"id\":\"c4\",\"originEventId\":\"origin:c4\",\"sourceRoot\":\"source:c4\",\"statement\":\"Synthetic supplied compromise_evidence for host-C\",\"timeMs\":157000,\"uncertaintyMs\":80},{\"assetRef\":\"host-C\",\"availableAtMs\":164200,\"concept\":\"source_correction\",\"id\":\"c8\",\"originEventId\":\"origin:c8\",\"retracts\":[\"c1\"],\"sourceRoot\":\"source:c8\",\"statement\":\"Synthetic supplied source_correction for host-C\",\"timeMs\":164000,\"uncertaintyMs\":80}],\"formatVersion\":\"notella.scenario-prefix.v1\",\"policyId\":\"network-scenario-policy-v1-development\",\"primaryAsset\":\"host-C\",\"scenarioId\":\"S-abd8262bab5a\",\"timeBasis\":\"shared-clock-asserted\"}","role":"user"},{"content":"{\"asOfMs\":164200,\"assessment\":{\"criticality\":\"critical\",\"evidenceRefs\":[\"c4\",\"c8\"],\"rationale\":\"Primary-asset access support remains in c4; withdrawn reports (c1) are excluded.\",\"status\":\"assessed\"},\"change\":{\"evidenceRefs\":[\"c8\"],\"summary\":\"Correction c8 withdraws reports c1 by originating event; preserve their retired history.\"},\"edges\":[{\"counts\":{\"provenanceRootCount\":2,\"reportCount\":2,\"underly