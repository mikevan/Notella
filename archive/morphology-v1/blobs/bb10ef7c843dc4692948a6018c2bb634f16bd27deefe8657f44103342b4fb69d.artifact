e-L\",\"concept\":\"source_correction\",\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"l8\"],\"id\":\"obs:l8\",\"kind\":\"observation\",\"status\":\"observed\"},{\"assetRef\":\"appliance-L\",\"concept\":\"attack_hypothesis\",\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"l8\"],\"id\":\"hypothesis:primary\",\"kind\":\"hypothesis\",\"status\":\"weakened\"}]}","role":"assistant"}],"outputSchema":"{\"additionalProperties\":false,\"properties\":{\"asOfMs\":{\"minimum\":0,\"type\":\"integer\"},\"assessment\":{\"additionalProperties\":false,\"properties\":{\"criticality\":{\"enum\":[\"contextual\",\"high\",\"critical\"],\"type\":\"string\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"rationale\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"assessed\",\"review_required\"],\"type\":\"string\"}},\"required\":[\"criticality\",\"status\",\"evidenceRefs\",\"rationale\"],\"type\":\"object\"},\"change\":{\"additionalProperties\":false,\"properties\":{\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"summary\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"evidenceRefs\",\"summary\"],\"type\":\"object\"},\"edges\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"from\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"minLength\":1,\"