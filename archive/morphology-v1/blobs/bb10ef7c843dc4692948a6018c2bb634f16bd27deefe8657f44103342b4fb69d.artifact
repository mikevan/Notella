ion\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"active\",\"inactive\"],\"type\":\"string\"},\"to\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\",\"from\",\"to\",\"relation\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"type\":\"array\"},\"nodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assetRef\":{\"minLength\":1,\"type\":\"string\"},\"concept\":{\"enum\":[\"reconnaissance\",\"credential_activity\",\"compromise_evidence\",\"benign_operation\",\"source_correction\",\"attack_hypothesis\"],\"type\":\"string\"},\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"id\":{\"minLength\":1,\"type\":\"string\"},\"kind\":{\"enum\":[\"observation\",\"hypothesis\"],\"type\":\"string\"},\"status\":{\"enum\":[\"observed\",\"retracted\",\"proposed\",\"supported\",\"weakened\",\"withdrawn\"],\"type\":\"string\"}},\"required\":[\"id\",\"kind\",\"concept\",\"assetRef\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"}},\"required\":[\"asOfMs\",\"nodes\",\"edges\",\"assessment\",\"change\"],\"type\":\"object\"}","promptSha256":"a1c43efd11240130c972a26e24facdc06f64bdacf68230d750e811f62909b8a6","source":{"id":"N-330","kind":"synthetic","labelAuthor":"Codex author/reviewer against unchanged rule reference; not independent","permission":"Owner-authorized curriculum repair; synthetic assertions","reference":"scenario-model-v5/prepare.py","trainingAllowed":true},"split":"train"}
{"concepts":["reconnaissance","credential_activity","compromise_evidence","benign_operation","source_correction","attack_hypothesis"],"datasetVersion":"notella-curriculum-v1","family":"retraction-authoring-suite-001","id":"N-440-step-1","messages":[{"content":"The ontology represents the semantic model. Reconstruct the evidence-backed semantic state from only the visible scenario prefix and interpret its morphology. Preserve observations, duplicates, corrections and previous graph identities. Use policy network-scenario-policy-v1-development: primary asset only; retractions invalidate all reports of the retracted underlying event. A current supplied reviewed compromise_evidence assertion warrants critical. Otherwise reconnaissance followed by credential_activity on the primary asset, with strictly supported order and an entire delay interval within 120000 ms, warrants high. Either alone is contextual. A benign_operation negates this scan/credential association only when its explains list covers both reports; it does not negate separate compromise evidence. Unresolved clocks or uncertain order for an otherwise relevant pair require review, not a guessed link. After a compromise retraction reassess the remaining evidence. Do not link unrelated assets, turn report counts into independent corroboration, or infer causation, actor identity or numerical attack probability. Full-prefix reconstruction is not evidence of persistent model memory.\nOntology: {\"concepts\":{\"attack_hypothesis\":\"A scoped interpretation of potentially related hostile activity, distinct from causal proof or perpetrator attribution.\",\"benign_operation\":\"A supplied reviewed explanation for explicitly referenced observations; not a universal clearance.\",\"compromise_evidence\":\"A supplied reviewed assertion of unauthorized privileged access; authenticity is established outside this model.\",\"credential_activity\":\"Observed authentication failures; not proof of successful access.\",\"reconnaissance\":\"An observed scan of an identified asset; not proof of compromise.\",\"source_correction\":\"An explicit retraction of earlier available evidence; retain the claim and its correction.\"},\"relations\":[{\"object\":\"attack_hypothesis\",\"predicate\":\"supports\",\"subject\":\"reconnaissance\"},{\"object\":\"attack_hypothesis\",\"predicate\":\"supports\",\"subject\":\"credential_activity\"},{\"object\":\"attack_hypothesis\",\"predicate\":\"supports\",\"subject\":\"compromise_evidence\"},{\"object\":\"attack_hypothesis\",\"predicate\":\"contradicts\",\"subject\":\"benign_operation\"},{\"object\":\"compromise_evidence\",\"predicate\":\"contradicts\",\"subject\":\"source_correction\"},{\"object\":\"credential_activity\",\"predicate\":\"precedes\",\"subject\":\"reconnaissance\"},{\"object\":\"compromise_evidence\",\"predicate\":\"precedes\",\"subject\":\"credential_activity\"}]}\nReturn JSON matching: {\"additionalProperties\":false,\"properties\":{\"asOfMs\":{\"minimum\":0,\"type\":\"integer\"},\"assessment\":{\"additionalProperties\":false,\"properties\":{\"criticality\":{\"enum\":[\"contextual\",\"high\",\"critical\"],\"type\":\"string\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"rationale\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"assessed\",\"review_required\"],\"type\":\"string\"}},\"required\":[\"criticality\",\"status\",\"evidenceRefs\",\"rationale\"],\"type\":\"object\"},\"change\":{\"additionalProperties\":false,\"properties\":{\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"summary\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"evidenceRefs\",\"summary\"],\"type\":\"object\"},\"edges\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"from\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"minLength\":1,\"type\":\"string\"},\"relation\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"active\",\"inactive\"],\"type\":\"string\"},\"to\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\",\"from\",\"to\",\"relation\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"type\":\"array\"},\"nodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assetRef\":{\"minLength\":1,\"type\":\"string\"},\"concept\":{\"enum\":[\"reconnaissance\",\"credential_activity\",\"compromise_evidence\",\"benign_operation\",\"source_correction\",\"attack_hypothesis\"],\"type\":\"string\"},\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"id\":{\"minLength\":1,\"type\":\"string\"},\"kind\":{\"enum\":[\"observation\",\"hypothesis\"],\"type\":\"string\"},\"status\":{\"enum\":[\"observed\",\"retracted\",\"proposed\",\"supported\",\"weakened\",\"withdrawn\"],\"type\":\"string\"}},\"required\":[\"id\",\"kind\",\"concept\",\"assetRef\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"}},\"required\":[\"asOfMs\",\"nodes\",\"edges\",\"assessment\",\"change\"],\"type\":\"object\"}","role":"system"},{"content":"{\"asOfMs\":97200,\"assets\":[\"terminal-G\"],\"evidence\":[{\"assetRef\":\"terminal-G\",\"availableAtMs\":80200,\"concept\":\"reconnaissance\",\"id\":\"g1\",\"originEventId\":\"origin:g1\",\"sourceRoot\":\"source:g1\",\"statement\":\"Synthetic supplied reconnaissance for terminal-G\",\"timeMs\":80000,\"uncertaintyMs\":80},{\"assetRef\":\"terminal-G\",\"availableAtMs\":85200,\"concept\":\"credential_activity\",\"id\":\"g2\",\"originEventId\":\"origin:g2\",\"sourceRoot\":\"source:g2\",\"statement\":\"Synthetic supplied credential_activity for terminal-G\",\"timeMs\":85000,\"uncertaintyMs\":80},{\"assetRef\":\"terminal-G\",\"availableAtMs\":90200,\"concept\":\"benign_operation\",\"explains\":[\"g1\",\"g2\"],\"id\":\"g3\",\"originEventId\":\"origin:g3\",\"sourceRoot\":\"source:g3\",\"statement\":\"Synthetic supplied benign_operation for terminal-G\",\"timeMs\":90000,\"uncertaintyMs\":80},{\"assetRef\":\"terminal-G\",\"availableAtMs\":97200,\"concept\":\"compromise_evidence\",\"id\":\"g5\",\"originEventId\":\"origin:g5\",\"sourceRoot\":\"source:g5\",\"statement\":\"Synthetic supplied compromise_evidence for terminal-G\",\"timeMs\":97000,\"uncertaintyMs\":80}],\"formatVersion\":\"notella.scenario-prefix.v1\",\"policyId\":\"network-scenario-policy-v1-development\",\"primaryAsset\":\"terminal-G\",\"scenarioId\":\"S-a70700dca231\",\"timeBasis\":\"shared-clock-asserted\"}","role":"user"},{"content":"{\"asOfMs\":97200,\"assessment\":{\"criticality\":\"critical\",\"evidenceRefs\":[\"g1\",\"g2\",\"g3\",\"g5\"],\"rationale\":\"g5 supplies active primary access evidence independently of the retired assertions none.\",\"status\":\"assessed\"},\"change\":{\"evidenceRefs\":[\"g5\"],\"summary\":\"Newly available reports g5 update the evidence state; report multiplicity does not imply independence.\"},\"edges\":[{\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"g1\"],\"from\":\"obs:g1\",\"id\":\"interpret:g1\",\"relation\":\"suppo