berate denial of service.\",\"observation\":\"A measured or reported event with source, place, time and uncertainty.\",\"signal_identity\":\"Generic RF energy is not confirmed drone identification.\",\"source_independence\":\"Separate reports are not independent when they derive from one observation.\",\"spatial_overlap\":\"Locations overlap within the supplied measurement uncertainty.\",\"temporal_precedence\":\"Event A precedes B only if their uncertainty intervals do not overlap.\",\"warning_posture\":\"Precautionary urgency under a named policy; not probability of attack.\"},\"relations\":[{\"object\":\"causal_claim\",\"predicate\":\"distinctFrom\",\"subject\":\"warning_posture\"},{\"object\":\"observation\",\"predicate\":\"qualifies\",\"subject\":\"temporal_precedence\"},{\"object\":\"observation\",\"predicate\":\"qualifies\",\"subject\":\"source_independence\"},{\"object\":\"warning_posture\",\"predicate\":\"constrains\",\"subject\":\"counterevidence\"}]}\nReturn JSON matching: {\"additionalProperties\":false,\"properties\":{\"combinedTrigger\":{\"enum\":[\"met\",\"unconfirmed\",\"not_met\"],\"type\":\"string\"},\"evidenceClass\":{\"enum\":[\"corroborated_drone\",\"unidentified_signal\",\"cause_unresolved\",\"reversed_sequence\",\"unknown_time\",\"different_location\",\"benign_explanation\",\"dependent_reports\",\"outside_window\",\"uncertain_order\"],\"type\":\"string\"},\"posture\":{\"enum\":[\"critical\",\"high\",\"contextual\"],\"type\":\"string\"}},\"required\":[\"posture\",\"combinedTrigger\",\"evidenceClass\"],\"type\":\"object\"}","role":"system"},{"content":"{\"facts\": [{\"factId\": \"capture_summary\", \"value\": {\"context\": \"Synthetic refugee camp under a supplied credible ongoing threat from an oppressive regime; this is context, not actor attribution.\", \"disruption\": {\"kind\": \"credible independently reviewed deliberate Wi-Fi denial of service\", \"location\": \"camp-area\", \"source\": \"network-monitor\", \"timeMs\": 36364, \"uncertaint