379200,\"assets\":[\"sensor-B\"],\"evidence\":[{\"assetRef\":\"sensor-B\",\"availableAtMs\":360200,\"concept\":\"reconnaissance\",\"id\":\"b3\",\"originEventId\":\"origin:b3\",\"sourceRoot\":\"source:b3\",\"statement\":\"Synthetic supplied reconnaissance for sensor-B\",\"timeMs\":360000,\"uncertaintyMs\":80},{\"assetRef\":\"sensor-B\",\"availableAtMs\":367200,\"concept\":\"compromise_evidence\",\"id\":\"b6\",\"originEventId\":\"origin:b6\",\"sourceRoot\":\"source:b6\",\"statement\":\"Synthetic supplied compromise_evidence for sensor-B\",\"timeMs\":367000,\"uncertaintyMs\":80},{\"assetRef\":\"sensor-B\",\"availableAtMs\":373200,\"concept\":\"benign_operation\",\"explains\":[\"b3\"],\"id\":\"b8\",\"originEventId\":\"origin:b8\",\"sourceRoot\":\"source:b8\",\"statement\":\"Synthetic supplied benign_operation for sensor-B\",\"timeMs\":373000,\"uncertaintyMs\":80},{\"assetRef\":\"sensor-B\",\"availableAtMs\":379200,\"concept\":\"source_correction\",\"id\":\"b9\",\"originEventId\":\"origin:b9\",\"retracts\":[\"b6\"],\"sourceRoot\":\"source:b9\",\"statement\":\"Synthetic supplied source_correction for sensor-B\",\"timeMs\":379000,\"uncertaintyMs\":80}],\"formatVersion\":\"notella.scenario-prefix.v1\",\"policyId\":\"network-scenario-policy-v1-development\",\"primaryAsset\":\"sensor-B\",\"scenarioId\":\"S-ee1f45d36cf0\",\"timeBasis\":\"shared-clock-asserted\"}","role":"user"},{"content":"{\"asOfMs\":379200,\"assessment\":{\"criticality\":\"contextual\",\"evidenceRefs\":[\"b3\",\"b8\",\"b9\"],\"rationale\":\"Retraction removes the compromise support; remaining evidence does not establish the configured scan/authentication link.\",\"status\":\"assessed\"},\"change\":{\"evidenceRefs\":[\"b9\"],\"summary\":\"Apply the new retraction to its originating event and all reposts, then reassess remaining primary-asset support. Retraction removes the compromise support; remaining evidence does not establish the configured scan/authentication link.\"},\"edges\":[{\"counts\":{\"provenance