nderlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"from\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"minLength\":1,\"type\":\"string\"},\"relation\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"active\",\"inactive\"],\"type\":\"string\"},\"to\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\",\"from\",\"to\",\"relation\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"type\":\"array\"},\"nodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assetRef\":{\"minLength\":1,\"type\":\"string\"},\"concept\":{\"enum\":[\"reconnaissance\",\"credential_activity\",\"compromise_evidence\",\"benign_operation\",\"source_correction\",\"attack_hypothesis\"],\"type\":\"string\"},\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"id\":{\"minLength\":1,\"type\":\"string\"},\"kind\":{\"enum\":[\"observation\",\"hypothesis\"],\"type\":\"string\"},\"status\":{\"enum\":[\"observed\",\"retracted\",\"proposed\",\"supported\",\"weakened\",\"withdrawn\"],\"type\":\"string\"}},\"required\":[\"id\",\"kind\",\"concept\",\"assetRef\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"}},\"required\":[\"asOfMs\",\"nodes\",\"edges\",\"assessment\",\"change\"],\"type\":\"object\"}","promptSha256":"13576b16a07ee991482166d7423cad3c2591b166304df0da66ceec17049e5776","source":{"id":"F-1120","kind":"synthetic","labelAuthor":"Codex author/reviewer against unchan