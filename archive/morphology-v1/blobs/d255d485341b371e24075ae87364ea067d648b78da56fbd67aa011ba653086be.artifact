l\"],\"type\":\"string\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"rationale\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"assessed\",\"review_required\"],\"type\":\"string\"}},\"required\":[\"criticality\",\"status\",\"evidenceRefs\",\"rationale\"],\"type\":\"object\"},\"change\":{\"additionalProperties\":false,\"properties\":{\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"summary\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"evidenceRefs\",\"summary\"],\"type\":\"object\"},\"edges\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"from\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"minLength\":1,\"type\":\"string\"},\"relation\":{\"minLength\":1,\"type\":\"string\"},\"status\":{\"enum\":[\"active\",\"inactive\"],\"type\":\"string\"},\"to\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\",\"from\",\"to\",\"relation\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"type\":\"array\"},\"nodes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assetRef\":{\"minLength\":1,\"type\":\"string\"},\"concept\":{\"enum\":[\"reconnaissance\",\"credential_activity\",\"compromise_evidence\",\"benign_operation\",\"source_correction\",\"attack_hypothesis\"],\"type\":\"string\"},\"counts\":{\"additionalProperties\":false,\"properties\":{\"provenanceRootCount\":{\"minimum\":0,\"type\":\"integer\"},\"reportCount\":{\"minimum\":0,\"type\":\"integer\"},\"underlyingEventCount\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"reportCount\",\"underlyingEventCount\",\"provenanceRootCount\"],\"type\":\"object\"},\"evidenceRefs\":{\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"id\":{\"minLength\":1,\"type\":\"string\"},\"kind\":{\"enum\":[\"observation\",\"hypothesis\"],\"type\":\"string\"},\"status\":{\"enum\":[\"observed\",\"retracted\",\"proposed\",\"supported\",\"weakened\",\"withdrawn\"],\"type\":\"string\"}},\"required\":[\"id\",\"kind\",\"concept\",\"assetRef\",\"status\",\"evidenceRefs\",\"counts\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"}},\"required\":[\"asOfMs\",\"nodes\",\"edges\",\"assessment\",\"change\"],\"type\":\"object\"}","promptSha256":"b6a83a68af9eebea6214175f1510226aee9382e563834a17630606396d86a24d","source":{"id":"network-scenario-authoring-v1","kind":"synthetic","labelAuthor":"Codex agent review against proposed policy; not independent domain validation","permission":"Explicit development admission under owner-authorized scenario training","reference":"scenario-model-v1/review.json","trainingAllowed":true},"split":"train"}
