m"},{"content":"{\"asOfMs\":13100,\"assets\":[\"host-A\",\"host-B\"],\"evidence\":[{\"assetRef\":\"host-A\",\"availableAtMs\":1100,\"concept\":\"reconnaissance\",\"id\":\"scan-1\",\"originEventId\":\"event:scan-1\",\"sourceRoot\":\"root:reconnaissance\",\"statement\":\"Synthetic supplied reconnaissance on host-A\",\"timeMs\":1000,\"uncertaintyMs\":100},{\"assetRef\":\"host-A\",\"availableAtMs\":4100,\"concept\":\"credential_activity\",\"id\":\"auth-1\",\"originEventId\":\"event:auth-1\",\"sourceRoot\":\"root:credential_activity\",\"statement\":\"Synthetic supplied credential_activity on host-A\",\"timeMs\":4000,\"uncertaintyMs\":100},{\"assetRef\":\"host-A\",\"availableAtMs\":9100,\"concept\":\"compromise_evidence\",\"id\":\"access-1\",\"originEventId\":\"event:access-1\",\"sourceRoot\":\"root:compromise_evidence\",\"statement\":\"Synthetic supplied compromise_evidence on host-A\",\"timeMs\":9000,\"uncertaintyMs\":100},{\"assetRef\":\"host-A\",\"availableAtMs\":13100,\"concept\":\"source_correction\",\"id\":\"correction-1\",\"originEventId\":\"event:correction-1\",\"retracts\":[\"access-1\"],\"sourceRoot\":\"root:source_correction\",\"statement\":\"Synthetic supplied source_correction on host-A\",\"timeMs\":13000,\"uncertaintyMs\":100}],\"formatVersion\":\"notella.scenario-prefix.v1\",\"policyId\":\"network-scenario-policy-v1-development\",\"primaryAsset\":\"host-A\",\"scenarioId\":\"S-e280429ceed0\",\"timeBasis\":\"shared-clock-asserted\"}","role":"user"},{"content":"{\"asOfMs\":13100,\"assessment\":{\"criticality\":\"high\",\"evidenceRefs\":[\"scan-1\",\"auth-1\",\"correction-1\"],\"rationale\":\"A supported scan-to-authentication sequence remains on the primary asset; compromise is not established.\",\"status\":\"assessed\"},\"change\":{\"evidenceRefs\":[\"correction-1\"],\"summary\":\"The newly available correction withdraws the originating access observation and all its reposts. Reassess remaining evidence; retain withdrawn nodes and inactive support.\"},\"edge