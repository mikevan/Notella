},{"content":"{\"asOfMs\":9100,\"assets\":[\"host-A\",\"host-B\"],\"evidence\":[{\"assetRef\":\"host-A\",\"availableAtMs\":1100,\"concept\":\"reconnaissance\",\"id\":\"scan-1\",\"originEventId\":\"event:scan-1\",\"sourceRoot\":\"root:reconnaissance\",\"statement\":\"Synthetic supplied reconnaissance on host-A\",\"timeMs\":1000,\"uncertaintyMs\":100},{\"assetRef\":\"host-A\",\"availableAtMs\":4100,\"concept\":\"credential_activity\",\"id\":\"auth-1\",\"originEventId\":\"event:auth-1\",\"sourceRoot\":\"root:credential_activity\",\"statement\":\"Synthetic supplied credential_activity on host-A\",\"timeMs\":4000,\"uncertaintyMs\":100},{\"assetRef\":\"host-B\",\"availableAtMs\":9100,\"concept\":\"reconnaissance\",\"id\":\"scan-other\",\"originEventId\":\"event:scan-other\",\"sourceRoot\":\"root:reconnaissance\",\"statement\":\"Synthetic supplied reconnaissance on host-B\",\"timeMs\":9000,\"uncertaintyMs\":100}],\"formatVersion\":\"notella.scenario-prefix.v1\",\"policyId\":\"network-scenario-policy-v1-development\",\"primaryAsset\":\"host-A\",\"scenarioId\":\"S-6a521aed1389\",\"timeBasis\":\"shared-clock-asserted\"}","role":"user"},{"content":"{\"asOfMs\":9100,\"assessment\":{\"criticality\":\"high\",\"evidenceRefs\":[\"scan-1\",\"auth-1\"],\"rationale\":\"A supported scan-to-authentication sequence remains on the primary asset; compromise is not established.\",\"status\":\"assessed\"},\"change\":{\"evidenceRefs\":[\"scan-other\"],\"summary\":\"The new evidence concerns another asset. Preserve its observation but do not add a link to the primary-asset hypothesis without an explicit bridge.\"},\"edges\":[{\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"scan-1\"],\"from\":\"obs:scan-1\",\"id\":\"interpret:scan-1\",\"relation\":\"supports\",\"status\":\"active\",\"to\":\"hypothesis:primary\"},{\"counts\":{\"provenanceRootCount\":1,\"reportCount\":1,\"underlyingEventCount\":1},\"evidenceRefs\":[\"auth-1\"],\"from\":\"obs