Window=true. Use high/unconfirmed/unidentified_signal for unidentified_rf. Use high/unconfirmed/cause_unresolved for outage_cause_unknown. Use high/unconfirmed/unknown_time for order=unknown, and high/unconfirmed/uncertain_order for order=uncertain. Use high/unconfirmed/dependent_reports for shared_origin reports. Use contextual/not_met/reversed_sequence for order=before; contextual/not_met/outside_window for order=after and withinWindow=false; contextual/not_met/different_location for different areaRef; contextual/not_met/benign_explanation for verified_maintenance or verified_humanitarian_drone. Verified benign operations negate this specific combined trigger even when temporal linkage exists. Contextual does not remove a separate hazard or standing threat. No output establishes causation, perpetrator identity or a certain attack.\nOntology: {\"concepts\":{\"causal_claim\":\"Requires evidence beyond temporal association; actor attribution is a separate claim.\",\"counterevidence\":\"Benign explanations, reversed order and absent corroboration constrain an interpretation.\",\"disruption_identity\":\"An outage is not sufficient evidence of deliberate denial of service.\",\"observation\":\"A measured or reported event with source, place, time and uncertainty.\",\"signal_identity\":\"Generic RF energy is not confirmed drone identification.\",\"source_independence\":\"Separate reports are not independent when they derive from one observation.\",\"spatial_overlap\":\"Locations overlap within the supplied measurement uncertainty.\",\"temporal_precedence\":\"Event A precedes B only if their uncertainty intervals do not overlap.\",\"warning_posture\":\"Precautionary urgency under a named policy; not probability of attack.\"},\"relations\":[{\"object\":\"causal_claim\",\"predicate\":\"distinctFrom\",\"subject\":\"warning_posture\"},{\"object\":\"observation\",\"predicate\":\"qualifies\",\"subject\":\"temporal_precedence\"},{\"object\":\"observation\",\"predicate\":\"qualifies\",\"subject\":\"source_independence\"},{\"object\":\"warning_posture\",\"predicate\":\"constrains\",\"subject\":\"counterevidence\"}]}\nReturn JSON matching: {\"additionalProperties\":false,\"enum\":[{\"combinedTrigger\":\"met\",\"evidenceClass\":\"corroborated_drone\",\"posture\":\"critical\"},{\"combinedTrigger\":\"not_met\",\"evidenceClass\":\"benign_explanation\",\"posture\":\"contextual\"},{\"combinedTrigger\":\"not_met\",\"evidenceClass\":\"different_location\",\"posture\":\"contextual\"},{\"combinedTrigger\":\"not_met\",\"evidenceClass\":\"outside_window\",\"posture\":\"contextual\"},{\"combinedTrigger\":\"not_met\",\"evidenceClass\":\"reversed_sequence\",\"posture\":\"contextual\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"cause_unresolved\",\"posture\":\"high\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"dependent_reports\",\"posture\":\"high\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"uncertain_order\",\"posture\":\"high\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"unidentified_signal\",\"posture\":\"high\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"unknown_time\",\"posture\":\"high\"}],\"properties\":{\"combinedTrigger\":{\"enum\":[\"met\",\"unconfirmed\",\"not_met\"],\"type\":\"string\"},\"evidenceClass\":{\"enum\":[\"corroborated_drone\",\"unidentified_signal\",\"cause_unresolved\",\"reversed_sequence\",\"unknown_time\",\"different_location\",\"benign_explanation\",\"dependent_reports\",\"outside_window\",\"uncertain_order\"],\"type\":\"string\"},\"posture\":{\"enum\":[\"critical\",\"high\",\"contextual\"],\"type\":\"string\"}},\"required\":[\"posture\",\"combinedTrigger\",\"evidenceClass\"],\"type\":\"object\"}","role":"system"},{"content":"{\"observation\":{\"context\":{\"ongoingThreat\":true},\"disruption\":{\"areaRef\":\"local_area\",\"classification\":\"reviewed_deliberate_disruption\"},\"drone\":{\"areaRef\":\"different_area\",\"classification\":\"corroborated_drone_identity\",\"sourceLineage\":{\"originGroups\":[0,1],\"relationship\":\"distinct_reviewed_origins\",\"reportCount\":2,\"reviewedDistinctOrigins\":2}},\"formatVersion\":\"layertime.decision-observation.v1\",\"time\":{\"configuredWindowMs\":220000,\"delayIntervalMs\":[34700,35060],\"order\":\"after\",\"withinWindow\":true}}}","role":"user"},{"content":"{\"combinedTrigger\":\"not_met\",\"evidenceClass\":\"different_location\",\"posture\":\"contextual\"}","role":"assistant"}],"outputSchema":"{\"additionalProperties\":false,\"enum\":[{\"combinedTrigger\":\"met\",\"evidenceClass\":\"corroborated_drone\",\"posture\":\"critical\"},{\"combinedTrigger\":\"not_met\",\"evidenceClass\":\"benign_explanation\",\"posture\":\"contextual\"},{\"combinedTrigger\":\"not_met\",\"evidenceClass\":\"different_location\",\"posture\":\"contextual\"},{\"combinedTrigger\":\"not_met\",\"evidenceClass\":\"outside_window\",\"posture\":\"contextual\"},{\"combinedTrigger\":\"not_met\",\"evidenceClass\":\"reversed_sequence\",\"posture\":\"contextual\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"cause_unresolved\",\"posture\":\"high\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"dependent_reports\",\"posture\":\"high\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"uncertain_order\",\"posture\":\"high\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"unidentified_signal\",\"posture\":\"high\"},{\"combinedTrigger\":\"unconfirmed\",\"evidenceClass\":\"unknown_time\",\"posture\":\"high\"}],\"properties\":{\"combinedTrigger\":{\"enum\":[\"met\",\"unconfirmed\",\"not_met\"],\"type\":\"string\"},\"evidenceClass\":{\"enum\":[\"corroborated_drone\",\"unidentified_signal\",\"cause_unresolved\",\"reversed_sequence\",\"unknown_time\",\"different_location\",\"benign_explanation\",\"dependent_reports\",\"outside_window\",\"uncertain_order\"],\"type\":\"string\"},\"posture\":{\"enum\":[\"critical\",\"high\",\"contextual\"],\"type\":\"string\"}},\"required\":[\"posture\",\"combinedTrigger\",\"evidenceClass\"],\"type\":\"object\"}","promptSha256":"373fd6c31ae3b02bbe087b29206c3930cf2f91003403b2b3f874de1b791ab32c","source":{"id":"student-v1-prospective-development","kind":"synthetic","labelAuthor":"Agent-authored known-pattern reference, not independent field validation","permission":"Project-authored synthetic development","reference":"v6-v4-ontoforge-distant-location-0","trainingAllowed":false},"split":"validation"}],"excludedPromptHashes":["2e8d7ccec50ca7445931c5c7c5f1e0cfa7e70bd42f190217ca964e53998cd593","2e944b7aadb9aa7b88714a881f9834d80e645e77be29e138038e489d3cee29ed","2fb5db655a170fcc64222bdcbe4aae6f3c15ec51e9695deb1d88eb6f9403cc26","715325fe2dc63b21ff4d4b4c1ad975a8cf3fa042a835ab044eddb96441e1ef44","7d23943a8dbbde146f3c6957e1b78c2c512b93fe1053b9a4479a5f2b9fbea9e0","8bda4a81191f1d05fce3b49c815fb759a883d491608cd6bd6af9bae27a7d4dbe","8d80616ede61295f6ca84613cf8047ac5f4d4bddf828037af8808a077ae820ad","a3131b819b2a9c1bcb8f55aab49febd057e5bf7c8c0f25532dfa313fda180085","cb30660f6093630bbd844daeb386b22c4f36c2226cb1e04078ad482c82f757d9","db8a4197efbe1b7846eb17ba44129da2a3d8ee9efc191f4aad75dc55618925c9"],"formatVersion":"notella.curriculum.v1","limitations":["Schema and integrity validation do not establish semantic correctness.","Synthetic variants are not independent field incidents."],"ontologyId":"de8b8fa925137177906f1422d92e9024f7253a4ff086f4ee10ef731ab4fa5092","releaseEligible":false,"splits":{"test":0,"train":45,"validation":8}}
